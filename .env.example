# KelasOffline — environment template. Copy to ".env" and fill with your own
# Firebase project's web config (Firebase console > Project settings > Your
# apps > Web app). These values are client identifiers, not secrets; access is
# protected by Firebase App Check + Firestore security rules.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check debug token (demo only). The AI Logic setup enforces App Check;
# for local development and this public demo we use the App Check debug
# provider. Generate your own UUID and register it in the Firebase console:
# App Check > Apps > your web app > Manage debug tokens.
VITE_APPCHECK_DEBUG_TOKEN=
